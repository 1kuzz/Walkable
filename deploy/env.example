# deploy/env.example
# Template for the server-side environment files used by the CI/CD pipeline.
#
# The pipeline reads TWO separate files on each build agent:
#
#   /opt/mops/.secrets    — sensitive credentials (passwords, tokens)
#   /opt/mops/prod.env    — per-environment config (admin users, client IDs)
#   /opt/mops/staging.env — same structure as prod.env, for staging
#
# HOW TO BOOTSTRAP ON A FRESH BUILD AGENT:
#   sudo mkdir -p /opt/mops
#   sudo cp deploy/env.example /opt/mops/.secrets   # fill in secrets section
#   sudo cp deploy/env.example /opt/mops/prod.env   # fill in prod config section
#   sudo chmod 600 /opt/mops/.secrets /opt/mops/prod.env
#   sudo chown <build-agent-user>:<build-agent-user> /opt/mops/.secrets /opt/mops/prod.env
#
# NEVER commit these files to source control.

# ─────────────────────────────────────────────────────────────────────────────
# /opt/mops/.secrets — Sensitive credentials
# Shared between staging and production pipeline steps.
# ─────────────────────────────────────────────────────────────────────────────

# Artifactory / npm registry credentials
NPM_USER=svc_mops_npm
NPM_PASSWORD=your_artifactory_password_here

# Docker registry credentials (used by compose-deploy.sh to run `docker login`
# before pulling images from the corporate mirror).
# If left empty, NPM_USER + NPM_PASSWORD are used as fallback — they grant access
# to the same Artifactory instance that serves both npm packages and Docker images.
DOCKER_REGISTRY_USER=
DOCKER_REGISTRY_PASSWORD=

# OIDC client secret (backend only — leave empty for PKCE/public SPA clients)
OIDC_CLIENT_SECRET=

# PostgreSQL superuser password
# Must match the value used when the database was first created.
POSTGRES_PASSWORD=your_strong_db_password_here

# JWT secret for signing local (mock) sessions
# Generate with: openssl rand -hex 32
LOCAL_JWT_SECRET=your_random_hex_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# /opt/mops/prod.env — Production configuration
# Values in this file override defaults for the production pipeline.
# ─────────────────────────────────────────────────────────────────────────────

# Docker registry mirror — prefix for all pulled images (node, nginx, postgres).
# Must include a trailing slash.
# Used by docker-compose as: ${DOCKER_REGISTRY:-}postgres:16-alpine
# compose-deploy.sh logs in to the registry host extracted from this value using
# the DOCKER_REGISTRY_USER/PASSWORD credentials (or NPM_USER/PASSWORD fallback).
# Leave empty to pull from Docker Hub directly.
DOCKER_REGISTRY=r-docker-all-in-one.repository.avp.ru:443/

# Comma-separated domain\login list of admin users.
# Must match the login that appears in the JWT preferred_username or sub claim.
VITE_ADMIN_USERS=KL\svc_portal_admin

# OIDC client ID registered in AD FS for the production portal.
# Obtain from ADFS-Administrators@kaspersky.com.
VITE_OIDC_CLIENT_ID=your_production_client_id_here

# Comma-separated list of OIDC role/group names that grant admin access.
# Leave empty to rely solely on VITE_ADMIN_USERS.
VITE_OIDC_ADMIN_ROLES=

# CORS allowed origin for the backend (should match the portal's public URL).
CORS_ORIGIN=https://mops.kaspersky.com

# Base URL of the Confluence instance served by the backend Confluence proxy.
VITE_CONFLUENCE_BASE_URL=https://confluence.kaspersky.com

# Confluence service account credentials (backend only).
# Option A — service account (username + password):
CONFLUENCE_USERNAME=svc_mops_confluence
CONFLUENCE_PASSWORD=your_confluence_password_here
# Option B — Personal Access Token (leave username/password empty if using PAT):
CONFLUENCE_PAT=

# ─────────────────────────────────────────────────────────────────────────────
# /opt/mops/staging.env — Staging configuration
# Same structure as prod.env but pointing to staging resources.
# ─────────────────────────────────────────────────────────────────────────────

# DOCKER_REGISTRY=r-docker-all-in-one.repository.avp.ru:443/
# VITE_ADMIN_USERS=KL\svc_portal_admin
# VITE_OIDC_CLIENT_ID=your_staging_client_id_here
# VITE_OIDC_ADMIN_ROLES=
# CORS_ORIGIN=https://staging.mops.kaspersky.com
# VITE_CONFLUENCE_BASE_URL=https://confluence.kaspersky.com
# CONFLUENCE_USERNAME=svc_mops_confluence
# CONFLUENCE_PASSWORD=your_confluence_password_here
# CONFLUENCE_PAT=

# ─────────────────────────────────────────────────────────────────────────────
# Pipeline variables — set in Azure DevOps or as env vars on the build agent
# ─────────────────────────────────────────────────────────────────────────────

# Webhook URL for deploy notifications (Teams / Slack / generic).
# Set as a pipeline variable in Azure DevOps, or add to /opt/mops/prod.env.
# Leave empty to skip deploy notifications.
# DEPLOY_WEBHOOK_URL=https://outlook.office.com/webhook/...
