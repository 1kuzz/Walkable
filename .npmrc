# npm configuration — committed to repo (no secrets).
# Registry and auth are configured at build time via:
#   - registry.env (local development)
#   - Docker build args (container builds)
#   - azure-pipelines.yml (CI)
#
# This file provides safe defaults that reduce external network calls
# and improve reliability in corporate / restricted-network environments.

# Prefer locally cached packages before hitting the registry.
prefer-offline=true

# Suppress funding messages during install.
fund=false

# Suppress update-notifier checks (avoids an external HTTP call).
update-notifier=false
