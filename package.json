{
  "name": "portal",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:i18n": "node scripts/check-i18n.mjs",
    "lint:md": "markdownlint \"README.md\" \"CONTRIBUTING.md\" \"QUICKSTART.md\" \"CHANGELOG.md\" \"SECURITY.md\" \"docs/**/*.md\"",
    "check:links": "bash -lc 'set -euo pipefail; files=(README.md CONTRIBUTING.md QUICKSTART.md CHANGELOG.md SECURITY.md); while IFS= read -r -d \"\" f; do files+=(\"$f\"); done < <(find docs -type f -name \"*.md\" -print0); for f in \"${files[@]}\"; do markdown-link-check \"$f\" -q -c .markdown-link-check.json; done'",
    "docs:api": "typedoc --options typedoc.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'tsc --noEmit'"
    ]
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/jszip": "^3.4.0",
    "dompurify": "^3.4.5",
    "jszip": "^3.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^18.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "adm-zip": "^0.5.17",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^24.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "eslint-visitor-keys": "^4.2.0"
  }
}
