# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
docs/api/

# Local environment variables — NEVER commit real secrets
.env
.env.local
.env.*.local

# Registry configuration (local overrides — see registry.env.example)
registry.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
*.log
Log.txt
npm-debug.log*

# Certificates and keys — never commit credentials or signing artifacts
*.cer
*.crt
*.pem
*.p12
*.pfx

# SAML / federation metadata — operational artifacts, not source code
*FederationMetadata.xml

# Scratch / internal notes
tz.txt

# TypeScript cache
*.tsbuildinfo

# Playwright
test-results/
playwright-report/

# Docker Compose local overrides — created from docker-compose.override.yml.example
docker-compose.override.yml

# Backup files (output of scripts/backup.sh)
backups/

# npm offline cache (output of scripts/vendor-deps.sh)
.npm-cache/
graphify-out/
.claude/
CLAUDE.md