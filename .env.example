# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/walkable

# NextAuth
# Keep this secret stable across deploys to avoid invalidating existing sessions.
NEXTAUTH_SECRET=replace-with-32-char-random-secret
NEXTAUTH_URL=http://localhost:3000
# Session persistence policy (defaults: maxAge=30d, updateAge=1d).
NEXTAUTH_SESSION_MAX_AGE_SECONDS=2592000
NEXTAUTH_SESSION_UPDATE_AGE_SECONDS=86400

# OAuth providers (at least one must be configured for sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# External APIs
# Map tiles (Esri World Imagery) and pedestrian routing (OSRM public API) do not require API keys.
YANDEX_WEATHER_API_KEY=
