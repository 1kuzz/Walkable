# Environment Variables
# Copy this to backend/.env on the server and fill in real values.
# Never commit .env to version control.

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://portal:CHANGE_ME@localhost:5432/portal

# --- Server ------------------------------------------------------------------
PORT=3001
UPLOADS_DIR=/var/www/walkable/app/backend/uploads
CORS_ORIGIN=https://1kuzz.org

# --- GitHub API (read-only token, raises rate limit 60→5000 req/h) -----------
GITHUB_TOKEN=

# --- GitHub OAuth App (Sign in with GitHub) ----------------------------------
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL:            https://1kuzz.org
#   Authorization callback:  https://1kuzz.org/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Session -----------------------------------------------------------------
# Random string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- URLs (used by OAuth redirect) -------------------------------------------
FRONTEND_URL=https://1kuzz.org
BACKEND_URL=https://1kuzz.org

# --- Admin panel -------------------------------------------------------------
# Bearer token for /api/projects/pending, approve/reject, refresh endpoints.
ADMIN_PASSWORD=

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
