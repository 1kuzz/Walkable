generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  weightKg      Float             @default(70)
  totalKm       Float             @default(0)
  routesCount   Int               @default(0)
  photosCount   Int               @default(0)
  accounts      Account[]
  sessions      Session[]
  routes        Route[]           @relation("CreatedRoutes")
  reviews       Review[]
  photos        Photo[]
  savedRoutes   SavedRoute[]
  achievements  Achievement[]
  completions   RouteCompletion[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ParkType {
  urban
  forest
  waterfront
  national
}

model Park {
  id              String   @id @default(cuid())
  osmId           String?  @unique
  name            String
  description     String?
  coverPhoto      String?
  type            ParkType @default(urban)
  lat             Float
  lng             Float
  geometryGeoJson String?  @db.Text
  routes          Route[]
  walkways        Walkway[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum Difficulty {
  easy
  moderate
  hard
}

enum SurfaceType {
  paved
  gravel
  dirt
  mixed
}

enum WalkwayType {
  footway
  path
  cycleway
  pedestrian
  steps
  track
  bridleway
}

model Route {
  id              String            @id @default(cuid())
  parkId          String
  name            String
  description     String?
  difficulty      Difficulty        @default(easy)
  lengthKm        Float             @default(0)
  elevationGain   Float             @default(0)
  surfaceType     SurfaceType       @default(mixed)
  transportMode   String            @default("foot")
  estimatedMin    Int               @default(0)
  geometryGeoJson String?           @db.Text
  createdById     String
  viewCount       Int               @default(0)
  park            Park              @relation(fields: [parkId], references: [id])
  createdBy       User              @relation("CreatedRoutes", fields: [createdById], references: [id])
  waypoints       Waypoint[]
  reviews         Review[]
  photos          Photo[]
  savedBy         SavedRoute[]
  sponsoredStops  SponsoredStop[]
  completions     RouteCompletion[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

enum WaypointType {
  bench
  viewpoint
  spring
  gazebo
  other
}

model Waypoint {
  id          String       @id @default(cuid())
  routeId     String
  lat         Float
  lng         Float
  type        WaypointType @default(other)
  name        String?
  description String?
  photos      Photo[]
  route       Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
}

model Walkway {
  id              String      @id @default(cuid())
  osmId           String      @unique
  parkId          String?
  name            String?
  type            WalkwayType
  geometryGeoJson String      @db.Text
  lat             Float
  lng             Float
  park            Park?       @relation(fields: [parkId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())

  @@index([parkId])
  @@index([type])
}

model Photo {
  id          String    @id @default(cuid())
  url         String
  publicId    String?
  userId      String
  routeId     String?
  waypointId  String?
  takenAt     DateTime?
  user        User      @relation(fields: [userId], references: [id])
  route       Route?    @relation(fields: [routeId], references: [id])
  waypoint    Waypoint? @relation(fields: [waypointId], references: [id])
  createdAt   DateTime  @default(now())
}

model Review {
  id        String   @id @default(cuid())
  routeId   String
  userId    String
  rating    Int      @default(5)
  body      String?  @db.Text
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([routeId, userId])
}

model SavedRoute {
  userId    String
  routeId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, routeId])
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  type       String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model SponsoredMeal {
  id             String          @id @default(cuid())
  name           String
  description    String?
  lat            Float
  lng            Float
  logoUrl        String?
  partnerUrl     String?
  isActive       Boolean         @default(true)
  sponsoredStops SponsoredStop[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model SponsoredStop {
  id         String        @id @default(cuid())
  routeId    String
  mealId     String
  stopOrder  Int           @default(0)
  route      Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  meal       SponsoredMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([routeId, mealId])
}

model RouteCompletion {
  id             String   @id @default(cuid())
  userId         String
  routeId        String
  durationMin    Int
  caloriesBurned Float
  completedAt    DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  route          Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}
